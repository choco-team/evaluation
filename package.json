{
  "name": "desktop",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "concurrently \"vite\" \"npm run start-electron\"",
    "start-electron": "cross-env NODE_ENV=development npm run build-electron && electron .",
    "build": "npm run build-electron && vite build",
    "build-electron": "tsc -p electron/tsconfig.main.json && powershell -Command \"New-Item -ItemType Directory -Force -Path dist-electron/utils; Copy-Item electron/utils/hwpParser.cjs -Destination dist-electron/utils/ -Force; Copy-Item electron/preload.js -Destination dist-electron/ -Force\"",
    "preview": "vite preview",
    "copy-cjs": "powershell Copy-Item electron/utils/hwpParser.cjs -Destination dist-electron/utils/ -Force",
    "electron:build": "npm run build && electron-builder"
  },
"build": {
  "appId": "com.example.myapp",
  "productName": "teachercan_evaluation",
  "icon": "electron/assets/teachercan",
  "directories": {
    "output": "release"
  },
  "files": [
    {
      "from": "dist",
      "to": "dist",
      "filter": ["**/*"]
    },
    {
      "from": "dist-electron",
      "to": "dist-electron",
      "filter": ["**/*"]
    },
    "preload.js",
    "package.json"
  ],
  "win": {
    "target": [
      "nsis"
    ]
  }
},
  "dependencies": {
    "@tailwindcss/vite": "^4.1.2",
    "eventsource": "^4.0.0",
    "he": "^1.2.0",
    "mammoth": "^1.9.0",
    "node-fetch": "^2.7.0",
    "node-hwp": "^0.1.0-alpha",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.2",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/he": "^1.2.3",
    "@types/node-fetch": "^2.6.12",
    "@types/plist": "^3.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "author": "Your Name",
  "description": "티처캔 평가 간소화 앱",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
